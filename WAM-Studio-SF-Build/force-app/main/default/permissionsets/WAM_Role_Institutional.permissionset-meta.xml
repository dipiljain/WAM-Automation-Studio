<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>WAM Role - Institutional</label>
    <description
  >Marks the user as a Wealth AI Studio Institutional Relationship Manager and grants access to the institutional (B2B) data model, classes, and home tab.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <customPermissions>
        <enabled>true</enabled>
        <name>WAM_Institutional</name>
    </customPermissions>
    <classAccesses><apexClass
    >WealthAIInstitutionalUseCaseService</apexClass><enabled
    >true</enabled></classAccesses>
    <classAccesses><apexClass
    >WealthAIDashboardResetService</apexClass><enabled
    >true</enabled></classAccesses>
    <objectPermissions>
        <object>Institutional_Mandate__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Institutional_Mandate__c.Account__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Institutional_Mandate__c.AI_Agent_Run__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Institutional_Mandate__c.Mandate_Type__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Institutional_Mandate__c.Allocation_Constraint__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Institutional_Mandate__c.Compliance_Status__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Institutional_Mandate__c.Breach_Detail__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Institutional_Mandate__c.Last_Reviewed__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <tabSettings>
        <tab>Institutional_Mandate__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>WAM_Institutional_Home</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
